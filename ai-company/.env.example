# Sao chép thành .env (hoặc chạy scripts/windows/tao-env.ps1 để tự tạo mật khẩu ngẫu nhiên).
# KHÔNG đưa tệp .env lên git. Token Telegram và khóa API LLM KHÔNG để ở đây: nhập trong trang quản trị (được mã hóa).
AICO_DB_PASSWORD=
# Khóa chủ ≥ 32 ký tự, dùng để mã hóa các secret nhập trong trang quản trị. Mất khóa này = phải nhập lại các secret.
AICO_MASTER_KEY=
